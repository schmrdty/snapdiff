# snapdiff public dashboard. Cherry VPS, Caddy with automatic TLS.
#
# Privacy posture: no `log` directive, so Caddy records no visitor IPs.
# Errors go to journald without request bodies. The dashboard is read-only
# data about two public networks; there is nothing private behind it.

{
	admin off
	# email you@example.com   # optional: ACME expiry notices
}

snapdiff.schmidtiest.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No external assets. Inline <style> is allowed. Scripts: the dashboard's own
		# node pager, pinned by the sha256 of its exact text (test/csp.test.ts checks
		# the hash against the rendered page, so a change to the script fails the
		# suite until this line is updated), and module files served from this origin
		# under /static (the Mini App ready() call and the vendored SDK bundle).
		# Nothing from a third party can run.
		# frame-ancestors is open on purpose: Farcaster and Hypersnap clients open
		# Mini Apps in iframes (web) or WebViews (mobile), and the page is read-only
		# with no actions a framing page could abuse. The X-Frame-Options header went with it.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'sha256-pCV/tf9HK02XeGrOMWOCLa+sk9XNi0vsuHClWl9xO1Q='; frame-ancestors *; base-uri 'none'; form-action 'none'"
		-Server
	}

	# To gate the whole site behind a password later: uncomment this block,
	# generate the hash on the VPS with `caddy hash-password`, paste it in,
	# then `sudo systemctl restart caddy` (reload needs the admin API, which is off).
	# basic_auth {
	# 	viewer <hash-from-caddy-hash-password>
	# }

	reverse_proxy 127.0.0.1:8787
}
