# snapdiff public dashboard. Cherry VPS, Caddy with automatic TLS.
#
# Privacy posture: no `log` directive, so Caddy records no visitor IPs.
# Errors go to journald without request bodies. The dashboard is read-only
# data about two public networks; there is nothing private behind it.

{
	admin off
	# email you@example.com   # optional: ACME expiry notices
}

snapdiff.schmidtiest.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# No external assets. Inline <style> is allowed; the only script allowed is
		# the dashboard's own node pager, pinned by the sha256 of its exact text
		# (test/csp.test.ts checks the hash against the rendered page, so a change
		# to the script fails the suite until this line is updated). Nothing else
		# can run, so even a rendering mistake cannot load code from a third party.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'sha256-pCV/tf9HK02XeGrOMWOCLa+sk9XNi0vsuHClWl9xO1Q='; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
	}

	# To gate the whole site behind a password later: uncomment this block,
	# generate the hash on the VPS with `caddy hash-password`, paste it in,
	# then `sudo systemctl reload caddy`.
	# basic_auth {
	# 	viewer <hash-from-caddy-hash-password>
	# }

	reverse_proxy 127.0.0.1:8787
}
