# Required. Bot token from BotFather, stored only in the VPS environment.
TELEGRAM_BOT_TOKEN=
# Optional. Writable path for persisted muted Telegram user IDs (never message text).
MUTE_FILE=/var/lib/snapdiff-telegram/muted-users.json
# Optional. Where /feedback lines are appended (one JSON object per line). This is the only
# place the bot stores message text.
FEEDBACK_FILE=/var/lib/snapdiff-telegram/feedback.jsonl
# Optional. Telegram chat id that also receives each feedback message (your own DM with the bot).
# Leave empty to only write the file.
FEEDBACK_CHAT_ID=
# Optional. One line shown by /tip: an address and chain, or a link. Unset = "tips are not set up yet".
TIP_TEXT=
