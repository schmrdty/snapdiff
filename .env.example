# Nodes (HTTP API). Public endpoints shown; replace with http://<host>:3381 for your own nodes.
NODE_A_LABEL=snapchain
NODE_A_URL=https://snapchain-api.neynar.com
# JSON object of extra request headers. Neynar needs an API key.
NODE_A_HEADERS={"x-api-key":"YOUR_NEYNAR_KEY"}
NODE_B_LABEL=hypersnap
NODE_B_URL=https://haatz.quilibrium.com
NODE_B_HEADERS=

# Storage and dashboard
DB_PATH=./data/snapdiff.db
PORT=8787

# Which FIDs to scan
WATCH_FIDS=
WATCH_FIDS_FILE=./watch-fids.txt
SAMPLE_SIZE=50
# 0 = use dbStats.numFidRegistrations from the nodes as the random upper bound
MAX_FID=0

# Timing
INFO_INTERVAL_SEC=60
SCAN_INTERVAL_MIN=15
RECHECK_INTERVAL_SEC=60
RECHECK_AFTER_MIN=5
UNEXPLAINED_AFTER_MIN=30
RECHECK_WINDOW_HOURS=24
LOOKBACK_HOURS=24
GRACE_SEC=60

# Classification
BEHIND_BLOCK_DELAY=50
V21_TEXT_BYTES=1024
# Message types the relay does not carry (comma-separated, exact names). Empty until the relay ships.
RELAY_FILTERED_TYPES=
# 1 = a FID with no ID registration on the missing node makes the diff relay_filtered
FID_ORIGIN_CHECK=1

# Requests
CONCURRENCY=4
MAX_PAGES_PER_FID=20
REQUEST_TIMEOUT_MS=10000

# Client health (docs/CLIENT-HEALTH.md). Unset = off. Keep the real file outside the deployed tree.
CLIENT_HEALTH_FILE=
CLIENT_HEALTH_INTERVAL_SEC=60
