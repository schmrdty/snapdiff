# Nodes (HTTP API). Two ways to list them:
#
# 1. Any number of nodes: NODES is a comma list of labels, and each label gets
#    NODE_<LABEL>_URL, NODE_<LABEL>_NETWORK (snapchain or hypersnap; optional when
#    the label contains the network name), and optionally NODE_<LABEL>_HEADERS
#    (label upper-cased, non-alphanumerics to _). REFERENCE_NODE anchors presentOn
#    and the dashboard (default: the first). Example with four nodes:
#      NODES=snapchain,haatz,opencaster,ohsnap
#      REFERENCE_NODE=snapchain
#      REFERENCE_NODE_2=haatz
#      NODE_SNAPCHAIN_URL=https://snapchain-api.neynar.com
#      NODE_SNAPCHAIN_HEADERS={"x-api-key":"YOUR_NEYNAR_KEY"}
#      NODE_HAATZ_URL=https://haatz.quilibrium.com
#      NODE_HAATZ_NETWORK=hypersnap
#      NODE_OPENCASTER_URL=https://REPLACE
#      NODE_OPENCASTER_NETWORK=hypersnap
#      NODE_OHSNAP_URL=https://ohsnap.schmidtiest.xyz
#      NODE_OHSNAP_NETWORK=hypersnap
#    Labels are 1 to 24 letters, digits, dashes, or dots and become the node ids in the database.
#    NODE_<LABEL>_PRIVATE=1 hides the node's host and URL everywhere (card, API, notes, errors):
#    the label is the only name shown. For nodes that live on a bare IP, for example:
#      NODE_HYPERSNAPE_NODE_URL=http://203.0.113.7:3381
#      NODE_HYPERSNAPE_NODE_PRIVATE=1
#    NODE_<LABEL>_NAME is a display name for the dashboard only (the label stays the id):
#      NODE_HAATZ_NAME=haatz.quilibrium.com
#    REFERENCE_NODE_2 is the other network's reference (default: its first-listed node).
#    Diff scope is judged per network: "node" when a same-network peer has the cast,
#    "network" when every node of that network lacks it (docs/MULTI-NODE.md).
#
# 2. Exactly two nodes, the original variables (used when NODES is unset):
NODE_A_LABEL=snapchain
NODE_A_URL=https://snapchain-api.neynar.com
# JSON object of extra request headers. Neynar needs an API key.
NODE_A_HEADERS={"x-api-key":"YOUR_NEYNAR_KEY"}
NODE_B_LABEL=hypersnap
NODE_B_URL=https://haatz.quilibrium.com
NODE_B_HEADERS=

# Fallback providers for a node (either form): NODE_<K>_URL_2, NODE_<K>_HEADERS_2, _3, ...
# tried in order when the one before refuses us (out of credits 402, bad key 401/403,
# rate limited 429) or does not answer. Same network, same data, different door.
# Merkle runs a free public Snapchain node; a benched provider is retried after
# PROVIDER_RETRY_MIN minutes.
NODE_A_URL_2=https://snap.farcaster.xyz:3381
PROVIDER_RETRY_MIN=10

# Storage and dashboard
DB_PATH=./data/snapdiff.db
PORT=8787

# Which FIDs to scan
WATCH_FIDS=
WATCH_FIDS_FILE=./watch-fids.txt
SAMPLE_SIZE=50
# 0 = use dbStats.numFidRegistrations from the nodes as the random upper bound
MAX_FID=0

# Timing
INFO_INTERVAL_SEC=60
SCAN_INTERVAL_MIN=15
RECHECK_INTERVAL_SEC=60
RECHECK_AFTER_MIN=5
UNEXPLAINED_AFTER_MIN=30
RECHECK_WINDOW_HOURS=24
LOOKBACK_HOURS=24
GRACE_SEC=60

# Classification
BEHIND_BLOCK_DELAY=50
V21_TEXT_BYTES=1024
# Message types the relay does not carry (comma-separated, exact names). Empty until the relay ships.
RELAY_FILTERED_TYPES=
# 1 = a FID with no ID registration on the missing node makes the diff relay_filtered
FID_ORIGIN_CHECK=1

# Requests
CONCURRENCY=4
MAX_PAGES_PER_FID=20
REQUEST_TIMEOUT_MS=10000

# Client health (docs/CLIENT-HEALTH.md). Unset = off. Keep the real file outside the deployed tree.
CLIENT_HEALTH_FILE=
CLIENT_HEALTH_INTERVAL_SEC=60
